{
  "name": "ai-devs-tasks",
  "version": "1.0.0",
  "description": "AI Devs Tasks",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx tasks/${npm_config_dir:-.}/index.ts",
    "dev": "tsx watch tasks/${npm_config_dir:-.}/index.ts",
    "vector-db-demo": "tsx scripts/vector-db-demo.ts",
    "mock-vector-demo": "tsx scripts/mock-vector-demo.ts",
    "test-connections": "tsx scripts/test-connections.ts",
    "qdrant-setup": "tsx scripts/qdrant-setup-helper.ts",
    "neo4j-graph-demo": "tsx scripts/neo4j-graph-demo.ts",
    "start-qdrant": "./scripts/start-qdrant.sh",
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@qdrant/js-client-rest": "^1.14.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.11.19",
    "@types/uuid": "^10.0.0",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsdom": "^26.1.0",
    "langfuse": "^3.37.2",
    "neo4j-driver": "^5.28.1",
    "openai": "^4.98.0",
    "sharp": "^0.34.1",
    "tesseract.js": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4"
  }
}
